// Generated by `clue install opencode`. Re-run the install command after upgrading clue; do not edit by hand.
import { execFileSync } from "node:child_process";

const CLUE_BIN = "__CLUE_BIN__";

function runClue(args, stdinText) {
  try {
    return execFileSync(CLUE_BIN, args, {
      input: stdinText,
      encoding: "utf8",
      timeout: 5000,
      env: { ...process.env, CLUE_HARNESS: "opencode" },
      stdio: ["pipe", "pipe", "ignore"],
    }).trim();
  } catch {
    return "";
  }
}

export const ClueMemoryPlugin = async ctx => {
  const cwd = ctx?.directory || process.cwd();
  const frozenBySession = new Map();

  const frozenBlock = sessionID => {
    const key = sessionID || "__default__";
    if (!frozenBySession.has(key)) frozenBySession.set(key, runClue(["boot", "--cwd", cwd, "--format", "text"]));
    return frozenBySession.get(key) || "";
  };

  return {
    "experimental.chat.system.transform": async (input, output) => {
      const block = frozenBlock(input?.sessionID);
      if (!block || !Array.isArray(output?.system)) return;
      if (!output.system.some(s => typeof s === "string" && s.includes("<clue-memory "))) output.system.push(block);
    },

    "chat.message": async (input, output) => {
      const parts = Array.isArray(output?.parts) ? output.parts : [];
      const userText = parts
        .filter(p => p && p.type === "text" && typeof p.text === "string")
        .map(p => p.text)
        .join("\n")
        .trim();
      if (!userText) return;
      const raw = runClue(
        ["hook", "prompt", "--harness", "opencode"],
        JSON.stringify({ session_id: input?.sessionID || "", cwd, prompt: userText }),
      );
      try {
        const parsed = raw ? JSON.parse(raw) : null;
        if (typeof parsed?.context === "string") parts.push({ type: "text", text: `\n\n${parsed.context}`, synthetic: true });
      } catch {
        // ignore malformed output
      }
    },

    "experimental.session.compacting": async (_input, output) => {
      if (Array.isArray(output?.context)) {
        output.context.push(
          "若本段对话里有值得长期记住、但还没放进 clue 待确认草稿箱的内容，在摘要末尾单列一节「待记忆线索」。",
        );
      }
    },
  };
};
