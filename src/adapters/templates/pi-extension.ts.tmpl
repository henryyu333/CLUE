// Generated by `clue install __HARNESS__`. Re-run the install command after upgrading clue; do not edit by hand.
import {
	buildBootSnapshot,
	buildDreamPacket,
	buildProactiveFlashback,
	buildTurnNotice,
	describeCommitsSince,
	detectInvoker,
	ensureClueStorage,
	formatDecisionGuidance,
	formatDraftList,
	formatNoteGuidance,
	formatPitfallGuidance,
	getHeadSha,
	isWorkerRole,
	loadClueConfig,
	lookedUpSince,
	noteHarnessSeen,
	readDrafts,
	recordHits,
	resolveProjectKey,
	searchLedger,
	addDraft,
	skippedIntentSlots,
	type DecisionRow,
	type DraftKind,
	type NoteRow,
	type PitfallRow,
} from "__CLUE_CORE__";

const HARNESS = "__HARNESS__";

/** The subset of the OMP / pi extension API this adapter uses (both hosts share it). */
interface HostContext {
	cwd: string;
	agent?: { kind?: string };
	sessionManager?: { getSessionId?: () => string };
	getSystemPrompt?: () => string;
}
interface HostApi {
	on(event: string, handler: (event: Record<string, unknown>, ctx: HostContext) => unknown): void;
	sendMessage(message: Record<string, unknown>, options?: Record<string, unknown>): void;
	sendUserMessage?(content: string): void;
	registerCommand(name: string, spec: { description: string; handler: (args: string | undefined, ctx: HostContext) => unknown }): void;
	registerTool?(spec: Record<string, unknown>): void;
	setLabel?(label: string): void;
	zod?: typeof import("zod");
}

export default function clueMemory(pi: HostApi) {
	process.env.CLUE_HARNESS ??= HARNESS;
	const config = loadClueConfig(process.env.CLUE_HOME?.trim() || "__CLUE_HOME__");
	const paths = ensureClueStorage(config);
	const worker = isWorkerRole();
	pi.setLabel?.(worker ? "clue (read-only worker)" : "clue");

	let frozenBlock = "";
	let compactions = 0;
	let sessionStartedAt = new Date().toISOString();
	let turnStartSha = "";
	const viewed = new Set<string>();

	const isMain = (ctx: HostContext) => !ctx.agent?.kind || ctx.agent.kind === "main";
	const sessionId = (ctx: HostContext) => ctx.sessionManager?.getSessionId?.() ?? "";

	const reset = (ctx: HostContext) => {
		if (!isMain(ctx)) return;
		frozenBlock = buildBootSnapshot(config, paths, ctx.cwd).block;
		compactions = 0;
		sessionStartedAt = new Date().toISOString();
		viewed.clear();
		noteHarnessSeen(paths, HARNESS);
	};
	pi.on("session_start", (_e, ctx) => reset(ctx));
	pi.on("session_clear", (_e, ctx) => reset(ctx));
	pi.on("session_switch", (_e, ctx) => reset(ctx));

	pi.on("session.compacting", (_e, ctx) => {
		if (!isMain(ctx) || worker) return;
		compactions += 1;
		return {
			context: [
				"若本段对话里有值得长期记住、但还没放进 clue 待确认草稿箱的内容（用户偏好或个人事实、项目方向变化、踩坑根因、关键决定），在摘要末尾单列一节「待记忆线索」。",
			],
		};
	});

	pi.on("before_agent_start", (event, ctx) => {
		if (!isMain(ctx) || event.reason === "revive") return;
		if (!frozenBlock) reset(ctx);
		turnStartSha = getHeadSha(paths.home);
		const prompt = typeof event.prompt === "string" ? event.prompt : "";
		const base = ctx.getSystemPrompt?.() ?? "";
		const systemPrompt = frozenBlock && !base.includes("<clue-memory ") ? `${base}\n\n${frozenBlock}` : undefined;
		const sid = sessionId(ctx);

		let notice = buildTurnNotice(config, paths, prompt, ctx.cwd, {
			compactions,
			sessionRef: sid ? `${HARNESS}:${sid}` : undefined,
			viewedKeys: [...viewed, ...lookedUpSince(paths, sessionStartedAt)],
		});
		if (!notice && prompt.trim()) {
			const fb = buildProactiveFlashback(config, paths, prompt, resolveProjectKey(ctx.cwd, config.workspaceRoots), viewed, sid || undefined);
			if (fb.notice) {
				notice = fb.notice;
				for (const item of fb.items) viewed.add(item.key);
			}
		}
		if (!notice) return systemPrompt ? { systemPrompt } : undefined;
		return {
			...(systemPrompt ? { systemPrompt } : {}),
			message: { customType: "clue-memory", content: notice, display: false, attribution: "user" },
		};
	});

	// System-generated receipt: whatever the model says, the user sees exactly what was committed this turn.
	pi.on("agent_end", (_e, ctx) => {
		if (!isMain(ctx) || !turnStartSha) return;
		const receipt = describeCommitsSince(paths.home, turnStartSha);
		turnStartSha = "";
		if (!receipt) return;
		pi.sendMessage({
			customType: "clue-receipt",
			content: `🧠 clue 本轮记忆提交（说「撤回记忆」可撤回）\n${receipt}`,
			display: true,
			excludeFromContext: true,
			attribution: "agent",
		});
	});

	pi.registerCommand("clue", {
		description: "clue: status | drafts | wrap | dream",
		handler: (args, ctx) => {
			const sub = (args ?? "").trim();
			if (sub === "wrap") {
				pi.sendUserMessage?.("收尾");
				return;
			}
			const content =
				sub === "dream"
					? buildDreamPacket(config, paths, resolveProjectKey(ctx.cwd, config.workspaceRoots), ctx.cwd)
					: sub === "drafts"
						? formatDraftList(readDrafts(paths))
						: buildBootSnapshot(config, paths, ctx.cwd).block;
			pi.sendMessage({ customType: "clue-status", content, display: true, excludeFromContext: true, attribution: "agent" });
		},
	});

	const z = pi.zod;
	if (!pi.registerTool || !z) return;

	pi.registerTool({
		name: "memory_search",
		label: "Search memory (clue)",
		description:
			"Search the user's personal memory: pitfalls (verified root causes), key decisions, and notes. Separate alternative phrasings with | to search several wordings at once.",
		loadMode: "discoverable",
		approval: "read",
		parameters: z.object({
			query: z.string().describe('Keywords; e.g. "打包崩溃 | makensis bad_alloc". Empty lists recent rows.'),
			type: z.enum(["all", "pitfall", "decision", "note"]).optional(),
			project: z.string().optional(),
			limit: z.number().optional(),
		}),
		async execute(_id: string, params: { query: string; type?: string; project?: string; limit?: number }, _s: unknown, _u: unknown, ctx: HostContext) {
			const proj = params.project?.trim().toLowerCase() || resolveProjectKey(ctx.cwd, config.workspaceRoots);
			const lim = Math.max(1, Math.min(10, Math.floor(params.limit ?? 4)));
			const want = (k: string) => !params.type || params.type === "all" || params.type === k;
			const decisions = want("decision") ? searchLedger<DecisionRow>(paths, "decision", params.query, proj, lim) : [];
			const pitfalls = want("pitfall") ? searchLedger<PitfallRow>(paths, "pitfall", params.query, proj, lim) : [];
			const notes = want("note") ? searchLedger<NoteRow>(paths, "note", params.query, proj, lim) : [];
			const keys = [
				...decisions.map(r => `decision:${r.id}`),
				...pitfalls.map(r => `pitfall:${r.id}`),
				...notes.map(r => `note:${r.id}`),
			];
			if (params.query.trim()) recordHits(paths, keys);
			for (const k of keys) viewed.add(k);
			const parts = [
				...(decisions.length ? [formatDecisionGuidance(decisions)] : []),
				...(pitfalls.length ? [formatPitfallGuidance(pitfalls)] : []),
				...(notes.length ? [formatNoteGuidance(notes)] : []),
			];
			return { content: [{ type: "text", text: parts.join("\n\n") || "未检索到匹配的记忆（换几种说法用 | 分隔再查）。" }] };
		},
	});

	if (worker) return;

	pi.registerTool({
		name: "memory_draft",
		label: "Draft a memory change (clue)",
		description:
			"Park a proposed memory change in clue's draft box. Nothing is written until the user confirms and `clue apply` runs. kind: note (preference/fact), pitfall, decision, intent (project 4-slot card), profile / projects (curate, needs scope + operations).",
		loadMode: "discoverable",
		approval: "allow",
		parameters: z.object({
			kind: z.enum(["note", "pitfall", "decision", "intent", "profile", "projects"]),
			op: z.enum(["add", "update", "supersede", "verify", "revert", "delete", "set", "clear"]).optional(),
			id: z.number().optional(),
			reason: z.string().optional().describe("One-line summary shown to the user"),
			project: z.string().optional(),
			tags: z.string().optional().describe("Comma-separated synonyms/aliases to help future search"),
			evidence: z.string().optional(),
			content: z.string().optional(),
			symptom: z.string().optional(),
			rootCause: z.string().optional(),
			historicalFix: z.string().optional(),
			rethinkHint: z.string().optional(),
			topic: z.string().optional(),
			decision: z.string().optional(),
			rationale: z.string().optional(),
			assumptions: z.string().optional(),
			revisitWhen: z.string().optional(),
			goal: z.string().optional(),
			approach: z.string().optional(),
			nonGoals: z.string().optional(),
			checkpoint: z.string().optional(),
			scope: z.string().optional(),
			operations: z
				.array(
					z.object({
						action: z.enum(["add", "patch", "remove"]),
						section: z.string().optional(),
						oldText: z.string().optional(),
						expectedEntry: z.string().optional(),
						forcePin: z.boolean().optional(),
						content: z.string().optional(),
					}),
				)
				.optional(),
		}),
		async execute(_id: string, params: Record<string, unknown> & { kind: DraftKind }, _s: unknown, _u: unknown, ctx: HostContext) {
			const { kind, ...rest } = params;
			const request =
				kind === "profile" || kind === "projects"
					? { ...rest, target: kind }
					: kind === "intent"
						? { ...rest, op: rest.op ?? "set" }
						: { ...rest, op: rest.op ?? "add" };
			const sid = sessionId(ctx);
			// The host validated params against the zod schema; the draft planner validates the fields again.
			const typed = request as Parameters<typeof addDraft>[3];
			const res = addDraft(config, paths, kind, typed, {
				projectKey: resolveProjectKey(ctx.cwd, config.workspaceRoots),
				harness: HARNESS,
				session: sid || detectInvoker().session,
				skipSlots: skippedIntentSlots(config, ctx.cwd),
			});
			return { isError: !res.ok, content: [{ type: "text", text: res.message }] };
		},
	});
}
